{
  "name": "orthodox-routes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:auth": "vitest run src/lib/auth src/lib/supabase/config.test.ts src/app/auth",
    "test:account": "node scripts/verify-account-foundation.mjs",
    "test:phone": "node scripts/verify-phone-verification.mjs",
    "test:drafts": "node scripts/verify-contextual-registration.mjs",
    "test:transport": "node scripts/verify-transport-foundation.mjs",
    "test:agreements": "node scripts/verify-ride-agreements.mjs",
    "test:core-upgrade": "supabase db reset --local --version 20260820170000 && node scripts/verify-transport-foundation.mjs && supabase migration up --local && node scripts/verify-ride-agreements.mjs",
    "core:e2e:prepare": "node scripts/prepare-core-browser-e2e.mjs",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset --local",
    "db:stop": "supabase stop",
    "auth:start": "node scripts/local-auth.mjs",
    "auth:verify": "node scripts/verify-local-auth.mjs",
    "auth:stop": "supabase stop"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.0",
    "@supabase/supabase-js": "2.105.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "jsdom": "26.1.0",
    "supabase": "2.113.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "next": {
      "sharp": "0.35.0"
    }
  }
