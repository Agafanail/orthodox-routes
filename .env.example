# Public application configuration. Use the environment's HTTPS origin outside local development.
ORTHODOX_ROUTES_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC and never commit real values.
SUPABASE_SECRET_KEY=
CONTEXTUAL_REGISTRATION_SECRET=

# Bird SMS delivery. BIRD_API_KEY is secret; the regional base URL and sender are non-secret.
BIRD_API_KEY=
BIRD_API_BASE_URL=https://eu1.platform.bird.com
BIRD_SMS_SENDER=OrthoRoutes
