# Public application configuration. Use the environment's HTTPS origin outside local development.
ORTHODOX_ROUTES_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC and never commit real values.
SUPABASE_SECRET_KEY=
CONTEXTUAL_REGISTRATION_SECRET=

# Bird SMS delivery. BIRD_API_KEY is secret; the regional base URL and sender are non-secret.
BIRD_API_KEY=
BIRD_API_BASE_URL=https://eu1.platform.bird.com
BIRD_SMS_SENDER=OrthoRoutes

# Transactional ride/activity notifications. All values stay server-only. Generate one VAPID
# keypair once, increment VAPID_KEY_VERSION only when deliberately rotating it, and keep old-key
# subscriptions invalid until each device renews them. The worker secret authenticates the
# database-owned scheduler request; the Resend webhook secret verifies the raw provider request.
NOTIFICATION_WORKER_SECRET=
RESEND_API_KEY=
RESEND_NOTIFICATION_FROM=
RESEND_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
VAPID_KEY_VERSION=1

# Map provider. Absent means maps and suggestions stay unavailable while the board keeps working.
# Use `geoapify` for the selected vendor, or `local-fake` for local development only.
#
# TWO DIFFERENT Geoapify keys are required. Never reuse one value for both.
#  - the server key is used only for address search and route measurement. It stays on the
#    server and is restricted at Geoapify by allowed IP address.
#  - the render key is embedded in the page because map tiles are fetched by the browser. It is
#    restricted at Geoapify to this application's domains and to map rendering only, so it
#    cannot be used to spend searches or routes if someone copies it out of a page.
#
# Both belong in the hosting secret manager and are never committed.
ORTHODOX_ROUTES_MAP_PROVIDER=
ORTHODOX_ROUTES_MAP_SERVER_KEY=
NEXT_PUBLIC_ORTHODOX_ROUTES_MAP_RENDER_KEY=
